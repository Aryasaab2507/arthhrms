# ArthHRMS environment template
# Copy this file to an ignored environment-specific file and replace every
# placeholder. Never commit populated credentials.

# Runtime environment. These are optional overrides; production and local
# runtime generation apply mode-appropriate defaults when they are absent.
APP_ENV=replace_with_environment_name
PRODUCTION_MODE=replace_with_true_or_false
PILOT_MODE=replace_with_true_or_false
DEVELOPMENT_MODE=replace_with_true_or_false
DEMO_MODE=replace_with_true_or_false

# Supabase public client configuration. SUPABASE_URL and one public key are the
# only required frontend deployment variables.
SUPABASE_URL=https://replace-with-project-url.example.invalid
# Preferred for new projects. SUPABASE_ANON_KEY remains a compatible fallback.
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_TIMEOUT_MS=replace_with_timeout_in_milliseconds

# Legacy module-specific adapters. Keep false when canonical persistence is enabled.
USE_SUPABASE_EMPLOYEES=replace_with_true_or_false
USE_SUPABASE_ATTENDANCE=replace_with_true_or_false
USE_SUPABASE_LEAVE=replace_with_true_or_false
USE_SUPABASE_EXPENSES=replace_with_true_or_false
USE_SUPABASE_PAYROLL=replace_with_true_or_false
USE_SUPABASE_AUTH=replace_with_true_or_false
USE_SUPABASE_PASSWORD_RECOVERY=replace_with_true_or_false
USE_SUPABASE_IMPORTS=replace_with_true_or_false
USE_SUPABASE_STORAGE=replace_with_true_or_false
USE_SUPABASE_INVITES=replace_with_true_or_false
USE_SUPABASE_PERSISTENCE=replace_with_true_or_false

# Blueprint v2.1 rollout controls. These are optional and default to false until
# the matching additive migrations and application phase are deployed.
USE_PLATFORM_COMPANY_REGISTRY=replace_with_true_or_false
USE_COMPANY_ADMIN_SHELL=replace_with_true_or_false
USE_COMPANY_SETUP_ORCHESTRATION=replace_with_true_or_false
USE_INVITATION_CENTER=replace_with_true_or_false
USE_WORKFORCE_DATA_HUB=replace_with_true_or_false
USE_LIFECYCLE_TASKS=replace_with_true_or_false
USE_READINESS_CENTER=replace_with_true_or_false
USE_PLATFORM_AGGREGATES=replace_with_true_or_false

# Authentication callback routing. APP_ORIGIN is optional on Vercel because
# the runtime generator derives the production origin from
# VERCEL_PROJECT_PRODUCTION_URL and never from a preview deployment URL.
APP_ORIGIN=https://replace-with-app-host.example.invalid
INVITE_USER_ENDPOINT=https://replace-with-edge-function.example.invalid
AUTH_INVITE_REDIRECT_URL=https://replace-with-app-host.example.invalid/auth-callback.html
PASSWORD_RECOVERY_REDIRECT_URL=https://replace-with-app-host.example.invalid/auth-callback.html?flow=recovery
REQUIRE_APP_METADATA_ROLE=replace_with_true_or_false
REQUIRE_EMAIL_VERIFIED=replace_with_true_or_false

# Server-only Supabase Edge Function secret. Never expose this value to the
# browser, frontend JavaScript, logs, screenshots, or client-side hosting.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
ALLOWED_ORIGINS=https://replace-with-app-host.example.invalid

# Release-operator onboarding. Use only in an ignored operator environment file.
SUPABASE_PROJECT_REF=replace_with_supabase_project_ref
SUPABASE_ACCESS_TOKEN=replace_with_supabase_management_access_token
PLATFORM_OWNER_NAME=replace_with_platform_owner_name
PLATFORM_OWNER_EMAIL=replace_with_platform_owner_email
FIRST_SUPER_ADMIN_NAME=replace_with_first_super_admin_name
FIRST_SUPER_ADMIN_EMAIL=replace_with_first_super_admin_email
TENANT_ID=replace_with_tenant_id
ORGANIZATION_ID=replace_with_organization_id
