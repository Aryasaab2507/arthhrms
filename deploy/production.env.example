# Required browser-safe production configuration
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key

# Optional origin. Vercel derives this from VERCEL_PROJECT_PRODUCTION_URL.
# APP_ORIGIN=https://hr.example.com

# Optional overrides. Production runtime generation defaults to the secure
# values shown below when these variables are absent.
# APP_ENV=production
# PRODUCTION_MODE=true
# PILOT_MODE=false
# DEVELOPMENT_MODE=false
# DEMO_MODE=false
# SUPABASE_TIMEOUT_MS=10000
# REQUIRE_APP_METADATA_ROLE=true
# REQUIRE_EMAIL_VERIFIED=true
# USE_SUPABASE_AUTH=true
# USE_SUPABASE_PASSWORD_RECOVERY=true
# USE_SUPABASE_STORAGE=true
# USE_SUPABASE_INVITES=true
# USE_SUPABASE_PERSISTENCE=true

# Optional derived routes. Normally generated from SUPABASE_URL and APP_ORIGIN.
# INVITE_USER_ENDPOINT=https://replace-with-project-ref.supabase.co/functions/v1/invite-user
# AUTH_INVITE_REDIRECT_URL=https://hr.example.com/auth-callback.html

# Legacy module adapters remain disabled when canonical persistence is active.
# USE_SUPABASE_EMPLOYEES=false
# USE_SUPABASE_ATTENDANCE=false
# USE_SUPABASE_LEAVE=false
# USE_SUPABASE_EXPENSES=false
# USE_SUPABASE_PAYROLL=false
# USE_SUPABASE_IMPORTS=false
